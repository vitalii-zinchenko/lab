{
   "description": "PostgreSQL metrics from postgres_exporter: connections, transactions, cache, locks.",
   "panels": [
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "pg_stat_database_numbackends{job=\"$job\", datname=\"$database\"}",
               "legendFormat": "connections",
               "refId": "A"
            }
         ],
         "title": "Active Connections",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "bytes"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 0
         },
         "id": 2,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "pg_stat_database_size_bytes{job=\"$job\", datname=\"$database\"}",
               "legendFormat": "size",
               "refId": "A"
            }
         ],
         "title": "Database Size",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     {
                        "color": "red",
                        "value": null
                     },
                     {
                        "color": "orange",
                        "value": 0.90000000000000002
                     },
                     {
                        "color": "green",
                        "value": 0.98999999999999999
                     }
                  ]
               },
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 0
         },
         "id": 3,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n/\n(\n  sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n  + sum(rate(pg_stat_database_blks_read{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n)\n",
               "legendFormat": "cache hit ratio",
               "refId": "A"
            }
         ],
         "title": "Cache Hit Ratio",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 0
         },
         "id": 4,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(rate(pg_stat_database_xact_commit{job=\"$job\", datname=\"$database\"}[$__rate_interval])) + sum(rate(pg_stat_database_xact_rollback{job=\"$job\", datname=\"$database\"}[$__rate_interval]))",
               "legendFormat": "tps",
               "refId": "A"
            }
         ],
         "title": "Transactions / s",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 4
         },
         "id": 5,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "pg_stat_database_numbackends{job=\"$job\", datname=\"$database\"}",
               "legendFormat": "active",
               "refId": "A"
            }
         ],
         "title": "Connections",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 4
         },
         "id": 6,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pg_stat_database_xact_commit{job=\"$job\", datname=\"$database\"}[$__rate_interval])",
               "legendFormat": "commits/s",
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pg_stat_database_xact_rollback{job=\"$job\", datname=\"$database\"}[$__rate_interval])",
               "legendFormat": "rollbacks/s",
               "refId": "B"
            }
         ],
         "title": "Transaction Rate",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 12
         },
         "id": 7,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n/\n(\n  sum(rate(pg_stat_database_blks_hit{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n  + sum(rate(pg_stat_database_blks_read{job=\"$job\", datname=\"$database\"}[$__rate_interval]))\n)\n",
               "legendFormat": "cache hit ratio",
               "refId": "A"
            }
         ],
         "title": "Cache Hit Ratio",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 12
         },
         "id": 8,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pg_stat_database_temp_bytes{job=\"$job\", datname=\"$database\"}[$__rate_interval])",
               "legendFormat": "temp bytes/s",
               "refId": "A"
            }
         ],
         "title": "Temp Data Written",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 20
         },
         "id": 9,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pg_stat_database_deadlocks{job=\"$job\", datname=\"$database\"}[$__rate_interval])",
               "legendFormat": "deadlocks/s",
               "refId": "A"
            }
         ],
         "title": "Deadlocks",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 20
         },
         "id": 10,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (mode) (pg_locks_count{job=\"$job\", datname=\"$database\"})",
               "legendFormat": "{{mode}}",
               "refId": "A"
            }
         ],
         "title": "Locks by Mode",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "templating": {
      "list": [
         {
            "label": "Data Source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "label": "Job",
            "name": "job",
            "query": "label_values(pg_stat_database_numbackends, job)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "label": "Database",
            "name": "database",
            "query": "label_values(pg_stat_database_numbackends{job=\"$job\"}, datname)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "utc",
   "title": "PostgreSQL Overview",
   "uid": "postgres-overview"
}
