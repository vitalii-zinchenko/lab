{
   "description": "Rate, Errors, Duration for the Go/Gin API. Select job (required) and optionally filter by endpoint.",
   "panels": [
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 0,
            "y": 0
         },
         "id": 1,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum(rate(gin_requests_total{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval]))",
               "legendFormat": "req/s",
               "refId": "A"
            }
         ],
         "title": "Request Rate",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "percentunit"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 8,
            "y": 0
         },
         "id": 2,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "(sum(rate(gin_requests_total{job=\"$job\", method=~\"$method\", url=~\"$endpoint\", code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(gin_requests_total{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval]))",
               "legendFormat": "error rate",
               "refId": "A"
            }
         ],
         "title": "Error Rate",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 4,
            "w": 8,
            "x": 16,
            "y": 0
         },
         "id": 3,
         "options": {
            "colorMode": "value",
            "graphMode": "none",
            "reduceOptions": {
               "calcs": [
                  "lastNotNull"
               ]
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.99, sum by (le) (rate(gin_request_duration_seconds_bucket{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval])))",
               "legendFormat": "p99",
               "refId": "A"
            }
         ],
         "title": "p99 Latency",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 4
         },
         "id": 4,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (method, url) (rate(gin_requests_total{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval]))",
               "legendFormat": "{{method}} {{url}}",
               "refId": "A"
            }
         ],
         "title": "Request Rate by Endpoint",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 24,
            "x": 0,
            "y": 12
         },
         "id": 5,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "sum by (method, url) (rate(gin_requests_total{job=\"$job\", method=~\"$method\", url=~\"$endpoint\", code=~\"5..\"}[$__rate_interval]))",
               "legendFormat": "{{method}} {{url}}",
               "refId": "A"
            }
         ],
         "title": "Error Rate by Endpoint (5xx req/s)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 20
         },
         "id": 6,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.50, sum by (le) (rate(gin_request_duration_seconds_bucket{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval])))",
               "legendFormat": "p50",
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.95, sum by (le) (rate(gin_request_duration_seconds_bucket{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval])))",
               "legendFormat": "p95",
               "refId": "B"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.99, sum by (le) (rate(gin_request_duration_seconds_bucket{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval])))",
               "legendFormat": "p99",
               "refId": "C"
            }
         ],
         "title": "Latency Percentiles (aggregate)",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 20
         },
         "id": 7,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "histogram_quantile(0.99, sum by (le, method, url) (rate(gin_request_duration_seconds_bucket{job=\"$job\", method=~\"$method\", url=~\"$endpoint\"}[$__rate_interval])))",
               "legendFormat": "{{method}} {{url}}",
               "refId": "A"
            }
         ],
         "title": "p99 Latency by Endpoint",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "templating": {
      "list": [
         {
            "label": "Data Source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "label": "Job",
            "name": "job",
            "query": "label_values(gin_requests_total, job)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "label": "Method",
            "multi": true,
            "name": "method",
            "query": "label_values(gin_requests_total{job=\"$job\"}, method)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "includeAll": true,
            "label": "Endpoint",
            "multi": true,
            "name": "endpoint",
            "query": "label_values(gin_requests_total{job=\"$job\", method=~\"$method\"}, url)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "utc",
   "title": "API RED Metrics",
   "uid": "api-red"
}
