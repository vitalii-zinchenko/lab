         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pgbouncer_stats_totals_received_bytes_total{job=\"$job\", database=\"$database\"}[$__rate_interval])",
               "legendFormat": "received/s",
               "refId": "A"
            },
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pgbouncer_stats_totals_sent_bytes_total{job=\"$job\", database=\"$database\"}[$__rate_interval])",
               "legendFormat": "sent/s",
               "refId": "B"
            }
         ],
         "title": "Network Traffic",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 20
         },
         "id": 9,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "max(pgbouncer_pools_client_maxwait_seconds{job=\"$job\", database=\"$database\"})",
               "legendFormat": "max wait",
               "refId": "A"
            }
         ],
         "title": "Max Client Wait Time",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "s"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 20
         },
         "id": 10,
         "options": {
            "tooltip": {
               "mode": "multi"
            }
         },
         "pluginVersion": "v11.4.0",
         "targets": [
            {
               "datasource": {
                  "type": "prometheus",
                  "uid": "${datasource}"
               },
               "expr": "rate(pgbouncer_stats_totals_queries_duration_seconds_total{job=\"$job\", database=\"$database\"}[$__rate_interval])\n/\nrate(pgbouncer_stats_totals_queries_pooled_total{job=\"$job\", database=\"$database\"}[$__rate_interval])\n",
               "legendFormat": "avg query duration",
               "refId": "A"
            }
         ],
         "title": "Avg Query Duration",
         "type": "timeseries"
      }
   ],
   "refresh": "30s",
   "schemaVersion": 39,
   "templating": {
      "list": [
         {
            "label": "Data Source",
            "name": "datasource",
            "query": "prometheus",
            "type": "datasource"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "label": "Job",
            "name": "job",
            "query": "label_values(pgbouncer_up, job)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         },
         {
            "datasource": {
               "type": "prometheus",
               "uid": "${datasource}"
            },
            "label": "Database",
            "name": "database",
            "query": "label_values(pgbouncer_pools_client_active_connections{job=\"$job\"}, database)",
            "refresh": 2,
            "sort": 1,
            "type": "query"
         }
      ]
   },
   "time": {
      "from": "now-1h",
      "to": "now"
   },
   "timezone": "utc",
   "title": "PgBouncer Overview",
   "uid": "pgbouncer-overview"
}
