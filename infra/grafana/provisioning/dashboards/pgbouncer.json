               "expr": "sum(pgbouncer_pools_server_used_connections{job=\"$job\", database=\"$database\"})",
               "legendFormat": "used",
               "refId": "C"
            }
         ],
         "title": "Server Connections",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "ops"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 12
         },
         "id": 7,
         "options": {
