               "expr": "rate(pgbouncer_stats_totals_sql_transactions_pooled_total{job=\"$job\", database=\"$database\"}[$__rate_interval])",
               "legendFormat": "xact/s",
               "refId": "A"
            }
         ],
         "title": "Transaction Rate",
         "type": "timeseries"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "Bps"
            }
         },
         "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 12
         },
         "id": 8,
         "options": {
            "tooltip": {
               "mode": "multi"
