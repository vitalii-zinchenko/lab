               },
               "expr": "sum(pgbouncer_pools_server_active_connections{job=\"$job\", database=\"$database\"})",
               "legendFormat": "active servers",
               "refId": "A"
            }
         ],
         "title": "Active Servers",
         "type": "stat"
      },
      {
         "datasource": {
            "type": "datasource",
            "uid": "-- Mixed --"
         },
         "fieldConfig": {
            "defaults": {
               "unit": "short"
