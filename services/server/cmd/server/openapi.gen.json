{
  "components": {
    "schemas": {
      "ApiKey": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_used_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "created_at"
        ],
        "type": "object"
      },
      "CreatedApiKey": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "client_secret",
          "created_at"
        ],
        "type": "object"
      },
      "DailyUsage": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "date": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "date",
          "count"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "EventHistory": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel"
          }
        },
        "required": [
          "id",
          "level",
          "event_type",
          "created_at"
        ],
        "type": "object"
      },
      "EventLevel": {
        "enum": [
          "error",
          "warn",
          "info"
        ],
        "type": "string"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Item": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "NewApiKey": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "NewEvent": {
        "properties": {
          "details": {
            "type": "string"
          },
          "event_type": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel"
          }
        },
        "required": [
          "level",
          "event_type"
        ],
        "type": "object"
      },
      "NewItem": {
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "NewPost": {
        "properties": {
          "content": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "NewUsage": {
        "properties": {
          "operation": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "timestamp",
          "operation"
        ],
        "type": "object"
      },
      "NewUser": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 255,
            "type": "string"
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "email"
        ],
        "type": "object"
      },
      "Post": {
        "properties": {
          "content": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "userId",
          "content",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "PostPage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Post"
            },
            "type": "array"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "TokenRequest": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "client_secret": {
            "minLength": 1,
            "type": "string"
          },
          "grant_type": {
            "enum": [
              "client_credentials"
            ],
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "client_id",
          "client_secret"
        ],
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "format": "int64",
            "type": "integer"
          },
          "token_type": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "type": "object"
      },
      "UpdatePost": {
        "properties": {
          "content": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "UsageItem": {
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "operation": {
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "user_id",
          "timestamp",
          "operation"
        ],
        "type": "object"
      },
      "UsagePage": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/UsageItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "UsageStats": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DailyUsage"
            },
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "User": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "createdAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Lab API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api-keys": {
      "get": {
        "operationId": "ListApiKeys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApiKey"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List API keys for the authenticated user",
        "tags": [
          "Auth"
        ]
      },
      "post": {
        "operationId": "CreateApiKey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewApiKey"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedApiKey"
                }
              }
            },
            "description": "Created — client_secret is shown only once"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "User not found"
          }
        },
        "summary": "Create a new API key for a user",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api-keys/{clientId}": {
      "delete": {
        "operationId": "RevokeApiKey",
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Revoke an API key",
        "tags": [
          "Auth"
        ]
      }
    },
    "/ch-events": {
      "post": {
        "operationId": "CreateChEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHistory"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create a ClickHouse event (test endpoint)",
        "tags": [
          "Events"
        ]
      }
    },
    "/events": {
      "post": {
        "operationId": "CreateEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventHistory"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create an event",
        "tags": [
          "Events"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/items": {
      "get": {
        "operationId": "ListItems",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of items"
          }
        },
        "summary": "List all items",
        "tags": [
          "Items"
        ]
      },
      "post": {
        "operationId": "CreateItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create an item",
        "tags": [
          "Items"
        ]
      }
    },
    "/items/{id}": {
      "delete": {
        "operationId": "DeleteItem",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Delete an item by ID",
        "tags": [
          "Items"
        ]
      },
      "get": {
        "operationId": "GetItem",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Get an item by ID",
        "tags": [
          "Items"
        ]
      }
    },
    "/login": {
      "post": {
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid fields"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid email or password"
          }
        },
        "summary": "Login with email and password to get a JWT access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/posts": {
      "get": {
        "operationId": "ListPosts",
        "parameters": [
          {
            "in": "query",
            "name": "userId",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPage"
                }
              }
            },
            "description": "Cursor-paginated posts"
          }
        },
        "summary": "List posts for a user (cursor-paginated)",
        "tags": [
          "Posts"
        ]
      },
      "post": {
        "operationId": "CreatePost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPost"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a post for the authenticated user",
        "tags": [
          "Posts"
        ]
      }
    },
    "/posts/{id}": {
      "get": {
        "operationId": "GetPost",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Get a post by ID",
        "tags": [
          "Posts"
        ]
      },
      "patch": {
        "operationId": "UpdatePost",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePost"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found or not owned by caller"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Update a post's content (owner only)",
        "tags": [
          "Posts"
        ]
      }
    },
    "/token": {
      "post": {
        "operationId": "CreateToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid fields"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid credentials, expired, or revoked key"
          }
        },
        "summary": "Exchange client credentials for a JWT access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/usage": {
      "get": {
        "operationId": "GetUsage",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
