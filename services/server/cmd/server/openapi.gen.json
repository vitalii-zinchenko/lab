{
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_ApiKey": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "last_used_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "created_at"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_CreatedApiKey": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "client_secret",
          "created_at"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_NewApiKey": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          },
          "user_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "user_id"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_NewUser": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 255,
            "type": "string"
          },
          "username": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "email"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_TokenRequest": {
        "properties": {
          "client_id": {
            "format": "uuid",
            "type": "string"
          },
          "client_secret": {
            "minLength": 1,
            "type": "string"
          },
          "grant_type": {
            "enum": [
              "client_credentials"
            ],
            "type": "string"
          }
        },
        "required": [
          "grant_type",
          "client_id",
          "client_secret"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "format": "int64",
            "type": "integer"
          },
          "token_type": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "type": "object"
      },
      "internal_auth_spec_schemas_User": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "createdAt"
        ],
        "type": "object"
      },
      "internal_events_spec_schemas_EventHistory": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/internal_events_spec_schemas_EventLevel"
          }
        },
        "required": [
          "id",
          "level",
          "event_type",
          "created_at"
        ],
        "type": "object"
      },
      "internal_events_spec_schemas_EventLevel": {
        "enum": [
          "error",
          "warn",
          "info"
        ],
        "type": "string"
      },
      "internal_events_spec_schemas_NewEvent": {
        "properties": {
          "details": {
            "type": "string"
          },
          "event_type": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/internal_events_spec_schemas_EventLevel"
          }
        },
        "required": [
          "level",
          "event_type"
        ],
        "type": "object"
      },
      "internal_items_spec_schemas_Item": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "type": "object"
      },
      "internal_items_spec_schemas_NewItem": {
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "internal_shared_spec_schemas_Error": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Lab API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api-keys": {
      "get": {
        "operationId": "ListApiKeys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/internal_auth_spec_schemas_ApiKey"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List API keys for the authenticated user"
      },
      "post": {
        "operationId": "CreateApiKey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_auth_spec_schemas_NewApiKey"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_auth_spec_schemas_CreatedApiKey"
                }
              }
            },
            "description": "Created — client_secret is shown only once"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "User not found"
          }
        },
        "summary": "Create a new API key for a user"
      }
    },
    "/api-keys/{clientId}": {
      "delete": {
        "operationId": "RevokeApiKey",
        "parameters": [
          {
            "in": "path",
            "name": "clientId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Revoke an API key"
      }
    },
    "/ch-events": {
      "post": {
        "operationId": "CreateChEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_events_spec_schemas_NewEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_events_spec_schemas_EventHistory"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create a ClickHouse event (test endpoint)"
      }
    },
    "/events": {
      "post": {
        "operationId": "CreateEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_events_spec_schemas_NewEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_events_spec_schemas_EventHistory"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create an event"
      }
    },
    "/health": {
      "get": {
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Health check"
      }
    },
    "/items": {
      "get": {
        "operationId": "ListItems",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/internal_items_spec_schemas_Item"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of items"
          }
        },
        "summary": "List all items"
      },
      "post": {
        "operationId": "CreateItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_items_spec_schemas_NewItem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_items_spec_schemas_Item"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Create an item"
      }
    },
    "/items/{id}": {
      "delete": {
        "operationId": "DeleteItem",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Delete an item by ID"
      },
      "get": {
        "operationId": "GetItem",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_items_spec_schemas_Item"
                }
              }
            },
            "description": "OK"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "summary": "Get an item by ID"
      }
    },
    "/token": {
      "post": {
        "operationId": "CreateToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_auth_spec_schemas_TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_auth_spec_schemas_TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Missing or invalid fields"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Invalid credentials, expired, or revoked key"
          }
        },
        "summary": "Exchange client credentials for a JWT access token"
      }
    },
    "/users": {
      "post": {
        "operationId": "CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/internal_auth_spec_schemas_NewUser"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_auth_spec_schemas_User"
                }
              }
            },
            "description": "Created"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/internal_shared_spec_schemas_Error"
                }
              }
            },
            "description": "Username or email already taken"
          }
        },
        "summary": "Create a new user"
      }
    }
  }
}